{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entry points knip cannot infer from imports:
  //   - src/browser/terminal-client.ts  bundled by scripts/build-client.mjs
  //   - extensions/*            loaded at runtime via tmux-extension.json
  //                             manifests; backends run as `node dist/backend/server.js`,
  //                             UI files are esbuild entrypoints
  //   - packages/*              consumed by extensions via file: deps
  // (src/index.ts and scripts/* are auto-detected from package.json.)
  "entry": [
    "src/browser/terminal-client.ts",
    "extensions/git-workflow/backend/server.ts",
    "extensions/git-workflow/ui/app.ts",
    "extensions/git-workflow/ui/review.ts",
    "extensions/github-actions/backend/server.ts",
    "extensions/github-actions/ui/app.ts",
    "extensions/image-compressor/backend/server.ts",
    "packages/ext-sdk/src/index.ts",
    "packages/ext-gh-workflow/src/index.ts"
  ],
  // Deps declared in the extensions' own package.json files, invisible to
  // root-level knip: the @tmux-web/* file: deps resolve only once the
  // extensions' node_modules are installed (fresh CI checkouts don't have
  // them until build:exts runs), and the codemirror UI deps likewise.
  // Do NOT remove these based on local-only knip hints — locally the
  // extension node_modules exist, in CI they do not.
  "ignoreDependencies": [
    "@tmux-web/ext-sdk",
    "@tmux-web/ext-gh-workflow",
    "@codemirror/state",
    "@codemirror/view",
    "codemirror",
    "sharp"
  ],
  // Exported types are part of the extension API contracts even before they
  // have consumers inside this repo (same stance as the t3code reference).
  "rules": { "types": "off", "nsTypes": "off" }
}
